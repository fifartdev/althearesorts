{
  "version": 1,
  "locales": ["en", "el"],
  "fieldTypes": {
    "text": "Single line, plain text",
    "textarea": "Multi-line plain text; line breaks are preserved",
    "html": "Inline HTML: a, strong, em, br only",
    "paragraphs": "Paragraphs separated by a blank line; inline HTML allowed in each",
    "lines": "One item per line",
    "url": "URL or site-relative path",
    "image": "Media library attachment",
    "images": "Ordered list of media library attachments",
    "bool": "Checkbox",
    "select": "One of a fixed set of options",
    "blocks": "Article body: '## Heading', paragraphs, '- bullet' lists, 'Q:'/'A:' pairs, '[cta] Label | /href', '---' (new untitled section), '[address]' block",
    "group": "Fixed number of repeated sub-field sets"
  },

  "settings": {
    "option": "althea_settings",
    "groups": [
      { "key": "identity", "label": "Identity", "fields": [
        { "key": "site_name", "type": "text", "label": "Site name" },
        { "key": "site_tagline", "type": "text", "label": "Tagline", "l": true },
        { "key": "default_meta_description", "type": "textarea", "label": "Default meta description", "l": true }
      ]},
      { "key": "contact", "label": "Contact", "fields": [
        { "key": "phone", "type": "text", "label": "Phone (main)" },
        { "key": "phone_mobile", "type": "text", "label": "Phone (mobile)" },
        { "key": "email_reservations", "type": "text", "label": "Reservations email" },
        { "key": "email_info", "type": "text", "label": "General enquiries email" },
        { "key": "address", "type": "text", "label": "Address", "l": true },
        { "key": "lat", "type": "text", "label": "Latitude" },
        { "key": "lng", "type": "text", "label": "Longitude" },
        { "key": "google_maps_url", "type": "url", "label": "Google Maps business URL" }
      ]},
      { "key": "booking", "label": "Booking", "fields": [
        { "key": "booking_url", "type": "url", "label": "Booking engine URL", "help": "All Book buttons point here. Do not change without client approval." }
      ]},
      { "key": "social", "label": "Social", "fields": [
        { "key": "instagram_url", "type": "url", "label": "Instagram" },
        { "key": "facebook_url", "type": "url", "label": "Facebook" },
        { "key": "linkedin_url", "type": "url", "label": "LinkedIn" }
      ]},
      { "key": "navigation", "label": "Navigation", "fields": [
        { "key": "nav", "type": "lines", "label": "Main menu", "l": true, "help": "One item per line: Label | /path" }
      ]}
    ]
  },

  "postTypes": {
    "althea_room": {
      "label": "Rooms", "singular": "Room", "restBase": "althea-rooms", "icon": "dashicons-admin-home",
      "supports": ["title", "thumbnail", "page-attributes"],
      "help": "Title = room name (shown in both languages). Featured image = hero photo. Order = display order (the homepage shows rooms 4–6).",
      "fields": [
        { "key": "size", "type": "text", "label": "Size", "help": "e.g. 27 m²" },
        { "key": "featured", "type": "bool", "label": "Signature suite" },
        { "key": "gallery", "type": "images", "label": "Photo gallery" },
        { "key": "tagline", "type": "text", "label": "Tagline", "locales": ["en"] },
        { "key": "view", "type": "text", "label": "View", "locales": ["en"] },
        { "key": "short_desc", "type": "textarea", "label": "Description", "locales": ["en"] },
        { "key": "features", "type": "lines", "label": "Features", "locales": ["en"] },
        { "key": "list_view", "type": "text", "label": "View (accommodation list)", "locales": ["el"], "section": "Greek — accommodation list page" },
        { "key": "list_tagline", "type": "text", "label": "Tagline (accommodation list)", "locales": ["el"], "section": "Greek — accommodation list page" },
        { "key": "list_short_desc", "type": "textarea", "label": "Description (accommodation list)", "locales": ["el"], "section": "Greek — accommodation list page" },
        { "key": "list_features", "type": "lines", "label": "Features (accommodation list)", "locales": ["el"], "section": "Greek — accommodation list page" },
        { "key": "detail_view", "type": "text", "label": "View (room page)", "locales": ["el"], "section": "Greek — room page", "help": "Empty = the room page shows the English text." },
        { "key": "detail_short_desc", "type": "textarea", "label": "Description (room page)", "locales": ["el"], "section": "Greek — room page" },
        { "key": "detail_features", "type": "lines", "label": "Features (room page)", "locales": ["el"], "section": "Greek — room page" },
        { "key": "card_view", "type": "text", "label": "View (homepage card)", "locales": ["el"], "section": "Greek — homepage card" },
        { "key": "card_short_desc", "type": "textarea", "label": "Description (homepage card)", "locales": ["el"], "section": "Greek — homepage card" }
      ]
    },
    "althea_post": {
      "label": "Blog posts", "singular": "Blog post", "restBase": "althea-posts", "icon": "dashicons-welcome-write-blog",
      "supports": ["title", "excerpt", "thumbnail", "page-attributes"],
      "help": "One post per language. Order = position in the blog list (0 = first, shown as the featured post). Posts in different languages that are translations of each other share the same Translation key. Featured image = cover photo.",
      "fields": [
        { "key": "locale", "type": "select", "label": "Language", "options": ["en", "el"] },
        { "key": "route_slug", "type": "text", "label": "URL slug", "help": "The post URL is /journal/<slug> (or /el/journal/<slug>)." },
        { "key": "translation_key", "type": "text", "label": "Translation key", "help": "Same value on the EN and EL versions of an article." },
        { "key": "category", "type": "text", "label": "Category" },
        { "key": "read_time", "type": "text", "label": "Read time", "help": "e.g. 5 min read" },
        { "key": "display_date", "type": "text", "label": "Display date", "help": "e.g. August 2026" },
        { "key": "image_alt", "type": "text", "label": "Cover image alt text" },
        { "key": "image2", "type": "image", "label": "Second image" },
        { "key": "image2_alt", "type": "text", "label": "Second image alt text" },
        { "key": "seo_title", "type": "text", "label": "SEO title" },
        { "key": "seo_description", "type": "textarea", "label": "SEO description" },
        { "key": "seo_keywords", "type": "lines", "label": "SEO keywords" },
        { "key": "body", "type": "blocks", "label": "Article body", "help": "Leave empty to show the 'coming soon' message." }
      ]
    },
    "althea_faq": {
      "label": "FAQs", "singular": "FAQ", "restBase": "althea-faqs", "icon": "dashicons-editor-help",
      "supports": ["title", "page-attributes"], "taxonomies": ["althea_faq_cat"],
      "fields": [
        { "key": "question", "type": "text", "label": "Question", "l": true },
        { "key": "answer", "type": "textarea", "label": "Answer", "l": true }
      ]
    },
    "althea_gallery": {
      "label": "Gallery", "singular": "Gallery item", "restBase": "althea-gallery", "icon": "dashicons-format-gallery",
      "supports": ["title", "thumbnail", "page-attributes"], "taxonomies": ["althea_gallery_cat"],
      "help": "Featured image = the photo.",
      "fields": [
        { "key": "caption", "type": "text", "label": "Caption", "l": true },
        { "key": "wide", "type": "bool", "label": "Wide tile" }
      ]
    },
    "althea_testimonial": {
      "label": "Testimonials", "singular": "Testimonial", "restBase": "althea-testimonials", "icon": "dashicons-format-quote",
      "supports": ["title", "page-attributes"],
      "fields": [
        { "key": "quote", "type": "textarea", "label": "Quote", "l": true },
        { "key": "name", "type": "text", "label": "Guest name", "l": true },
        { "key": "origin", "type": "text", "label": "From", "l": true },
        { "key": "stay", "type": "text", "label": "Room stayed in", "l": true }
      ]
    },
    "althea_venue": {
      "label": "Dining venues", "singular": "Dining venue", "restBase": "althea-venues", "icon": "dashicons-food",
      "supports": ["title", "thumbnail", "page-attributes"],
      "help": "Slug is the page anchor (e.g. breakfast → /gastronomy#breakfast). AITHER is edited on the Gastronomy page.",
      "fields": [
        { "key": "label", "type": "text", "label": "Label", "l": true },
        { "key": "title", "type": "text", "label": "Heading", "l": true },
        { "key": "desc", "type": "textarea", "label": "Description", "l": true },
        { "key": "image_alt", "type": "text", "label": "Image alt text", "l": true }
      ]
    },
    "althea_spa_item": {
      "label": "Spa facilities & cabins", "singular": "Spa item", "restBase": "althea-spa-items", "icon": "dashicons-heart",
      "supports": ["title", "thumbnail", "page-attributes"],
      "fields": [
        { "key": "kind", "type": "select", "label": "Kind", "options": ["facility", "cabin"] },
        { "key": "name", "type": "text", "label": "Name", "l": true },
        { "key": "desc", "type": "textarea", "label": "Description", "l": true },
        { "key": "image_alt", "type": "text", "label": "Image alt text (cabins)", "l": true }
      ]
    },
    "althea_sight": {
      "label": "Sights", "singular": "Sight", "restBase": "althea-sights", "icon": "dashicons-location-alt",
      "supports": ["title", "thumbnail", "page-attributes"],
      "fields": [
        { "key": "name", "type": "text", "label": "Name", "l": true },
        { "key": "distance", "type": "text", "label": "Distance", "l": true },
        { "key": "desc", "type": "textarea", "label": "Description", "l": true },
        { "key": "category", "type": "text", "label": "Category", "l": true },
        { "key": "object_position", "type": "text", "label": "Image focus", "help": "CSS object-position, e.g. center bottom. Leave empty for centred." }
      ]
    },
    "althea_offer": {
      "label": "Offers", "singular": "Offer", "restBase": "althea-offers", "icon": "dashicons-tag",
      "supports": ["title", "thumbnail", "page-attributes"],
      "fields": [
        { "key": "active", "type": "bool", "label": "Show on Offers page" },
        { "key": "booking_url", "type": "url", "label": "Booking link for this offer" },
        { "key": "eyebrow", "type": "text", "label": "Eyebrow", "l": true },
        { "key": "heading", "type": "html", "label": "Heading", "l": true },
        { "key": "body", "type": "html", "label": "Text", "l": true },
        { "key": "cta_label", "type": "text", "label": "Booking button label", "l": true },
        { "key": "read_more_label", "type": "text", "label": "Second button label", "l": true },
        { "key": "read_more_href", "type": "url", "label": "Second button link", "l": true },
        { "key": "image_alt", "type": "text", "label": "Image alt text", "l": true }
      ]
    },
    "althea_reason": {
      "label": "Booking reasons", "singular": "Booking reason", "restBase": "althea-reasons", "icon": "dashicons-yes-alt",
      "supports": ["title", "page-attributes"],
      "help": "The 'Reasons to book directly' accordion (homepage and Offers page).",
      "fields": [
        { "key": "title", "type": "text", "label": "Title", "l": true },
        { "key": "body", "type": "textarea", "label": "Text", "l": true }
      ]
    },
    "althea_page": {
      "label": "Site pages", "singular": "Site page", "restBase": "althea-pages", "icon": "dashicons-media-document",
      "supports": ["title"],
      "help": "Text and images for one website page. The slug decides which page this is; do not change it.",
      "fields": []
    }
  },

  "taxonomies": {
    "althea_faq_cat": {
      "label": "FAQ categories", "singular": "FAQ category", "restBase": "althea-faq-cats", "postTypes": ["althea_faq"],
