DATABASE_URL=postgresql://...
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_META_PIXEL_ID=955309630869188
NEXT_PUBLIC_GOOGLE_MAPS_CID_URL=https://maps.google.com/?cid=16064789505503046924

# WordPress headless CMS (server-side only; never prefix with NEXT_PUBLIC_)
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
# Shared secret for POST /api/revalidate (same value as ALTHEA_REVALIDATE_SECRET in wp-config.php)
REVALIDATE_SECRET=
# Vercel 'Protection Bypass for Automation' secret (also ALTHEA_VERCEL_BYPASS in wp-config.php)
VERCEL_BYPASS=

# FTPS access to the WordPress server (npm run cms:deploy-plugin)
FTP_USER=
FTP_PASSWORD=

# Claude Code phone notifications (self-hosted ntfy)
NTFY_URL=
NTFY_TOPIC=
# Optional ntfy access token (if the topic requires auth)
NTFY_TOKEN=
